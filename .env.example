# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file with production secrets to source control.

# Flask
SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Set true only behind a real production WSGI server (gunicorn/waitress),
# never with the Flask development server.
PRODUCTION=false

# Database (leave blank to use the default project-relative data/registration.db)
DATABASE_PATH=

# SMTP (leave blank to keep the notification system in simulation mode,
# exactly as in Milestone 1/3 -- confirmation/reminder emails are logged
# instead of actually sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
